# TickVault environment. Phase 1 ingests public market data only and needs no secrets.

# Data root shared by the CLI, the dashboard and the Dagster assets.
TICKVAULT_DATA_DIR=./data

# Optional knobs for scripts/compose_smoke.sh (seconds; defaults shown).
# TICKVAULT_SMOKE_WAIT_SECONDS=60
# TICKVAULT_SMOKE_QA_TIMEOUT=120

# Phase 2: buffer between the ingester and the writer (FR-2.3).
# HOST:PORT publishes every raw envelope line to a Kafka-compatible broker;
# memory://NAME uses the in-process broker (tests only). Empty or unset = off.
# TICKVAULT_BUFFER=

# Phase 2: Prometheus text endpoint for `ingest` and `consume` (FR-2.4).
# Port to serve /metrics on; unset or 0 = off.
# TICKVAULT_METRICS_PORT=

# Phase 2: Grafana admin password for the local Compose demo (FR-2.4).
# This default is for the local demo only and is not a secret: anonymous
# viewers get read-only access, so the admin login is only needed to explore
# the provisioned dashboards as an editor. Set it to anything else locally if
# you prefer; never reuse it anywhere real.
# TICKVAULT_GRAFANA_ADMIN_PASSWORD=tickvault-admin
